# dados brutos e derivados (PRD 1.2 - nao versionar dados)
data/raw/
data/curated/
*.csv
*.csv.gz
*.xlsx
*.parquet
*.duckdb
*.dump
*.sql.gz

# os / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# As fixtures do pipeline sao derivadas dos datasets e precisam ser versionadas
