// Schema canonico do Creche Carioca.
//
// Cobre o subconjunto do modelo de PRD 11 que a Fase 2 utiliza. As entidades
// restantes (UnitCapacity,
// CriterionResponse, ScoreResult, AllocationRun, Allocation, Convocation,
// ContactAttempt, MessageTemplate) entram nas fases seguintes, conforme
// IMPLEMENTATION_PLAN.md.
//
// Convencoes:
// - Toda referencia publica usa UUID, nunca sequencial (PRD 13.5).
// - Instantes sao gravados em UTC com `@db.Timestamptz` (PRD 16.1).
// - Codigos e CEPs sao texto, preservando zeros a esquerda (PRD 10.3).
// - Nenhum campo nominal de crianca ou responsavel existe: apenas
//   identificadores anonimos (PRD 13.2, minimizacao).

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: a URL de conexao vive em `prisma.config.ts` (para o Migrate) e no
// driver adapter passado ao `PrismaClient` (para execucao). Nenhuma credencial
// no schema (PRD 13.4).
datasource db {
  provider = "postgresql"
}

/// Processo seletivo e suas datas de referencia (PRD 11).
model Process {
  id            String     @id @default(uuid()) @db.Uuid
  /// Codigo estavel usado nas APIs, ex.: "DEMO-2026".
  code          String     @unique
  name          String
  /// Data de corte padrao do processo, no formato YYYY-MM-DD.
  referenceDate String     @db.VarChar(10)
  /// `DEMONSTRACAO` impede que o processo seja lido como oficial (PRD 1.2).
  status        DataStatus
  createdAt     DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime   @updatedAt @db.Timestamptz(6)

  ruleVersions RuleVersion[]
  applications Application[]

  @@index([status])
}

/// Versao imutavel de regras, pesos e desempates (PRD 11, 8.7).
///
/// PRD 8.7: "Uma alteracao de peso deve criar nova versao, nunca reescrever
/// resultado historico." Por isso nao existe caminho de atualizacao para o
/// `payload`: publicar uma regra nova significa inserir uma nova linha.
model RuleVersion {
  id            String     @id @default(uuid()) @db.Uuid
  processId     String     @db.Uuid
  version       Int
  kind          RuleKind
  status        DataStatus
  /// Conteudo da regra validado por schema Zod na leitura.
  payload       Json
  /// Origem declarada, para rastreabilidade e auditoria.
  source        String
  effectiveFrom DateTime   @db.Timestamptz(6)
  createdAt     DateTime   @default(now()) @db.Timestamptz(6)

  process Process @relation(fields: [processId], references: [id], onDelete: Restrict)

  @@unique([processId, kind, version])
  @@index([processId, kind, effectiveFrom])
}

/// Identificador anonimo e dados minimos da crianca (PRD 8.1, 11).
model Child {
  id           String   @id @default(uuid()) @db.Uuid
  /// Referencia anonima exposta ao cliente. Nunca um dado nominal.
  anonymousRef String   @unique @db.Uuid
  birthYear    Int
  birthMonth   Int
  sex          Sex?
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  applications Application[]

  @@index([birthYear, birthMonth])
}

/// Identificador anonimo do responsavel (PRD 11).
///
/// Criado ja na Fase 2 para que `Application` carregue a chave estrangeira
/// desde o inicio. Passa a ser populado na Fase 5, junto com os contatos.
model Guardian {
  id           String   @id @default(uuid()) @db.Uuid
  anonymousRef String   @unique @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  applications Application[]
}

/// Inscricao da crianca no processo (PRD 11).
model Application {
  id                    String            @id @default(uuid()) @db.Uuid
  processId             String            @db.Uuid
  childId               String            @db.Uuid
  guardianId            String?           @db.Uuid
  status                ApplicationStatus @default(RASCUNHO)
  desiredShift          Shift
  /// Sobrescreve `Process.referenceDate` quando informado (PRD 8.1).
  referenceDateOverride String?           @db.VarChar(10)
  createdAt             DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime          @updatedAt @db.Timestamptz(6)

  process  Process   @relation(fields: [processId], references: [id], onDelete: Restrict)
  child    Child     @relation(fields: [childId], references: [id], onDelete: Restrict)
  guardian Guardian? @relation(fields: [guardianId], references: [id], onDelete: SetNull)

  statusEvents    StatusEvent[]
  locationAnchors LocationAnchor[]
  contactPoints   ContactPoint[]
  preferences     Preference[]

  /// Uma crianca tem no maximo uma inscricao por processo. Sustenta o principio
  /// "uma crianca, uma oferta" (PRD 7.3) e o alerta de multiplas selecoes para a
  /// mesma crianca (PRD 8.10).
  @@unique([processId, childId])
  @@index([processId, status])
  @@index([childId])
}

/// Ponto de referencia informado pela familia (PRD 8.2, RF-02).
///
/// Sao no maximo tres por inscricao. A posicao 1 e a residencia e e obrigatoria;
/// as posicoes 2 e 3 sao opcionais. Os pontos servem apenas a recomendacao e
/// nunca alteram a pontuacao oficial (PRD 8.2).
model LocationAnchor {
  id            String     @id @default(uuid()) @db.Uuid
  applicationId String     @db.Uuid
  /// 1 = residencia, 2 e 3 opcionais. Unica por inscricao.
  position      Int        @db.SmallInt
  kind          AnchorKind
  /// CEP como texto de 8 digitos, preservando zeros a esquerda (PRD 10.3).
  cep           String     @db.VarChar(8)
  /// Rotulo amigavel escolhido pela familia. Texto livre: escapado na exibicao.
  label         String?    @db.VarChar(60)

  status       GeocodingStatus @default(PENDENTE)
  latitude     Float?
  longitude    Float?
  /// Raio de incerteza declarado pelo provider, em quilometros. Existe para que
  /// a interface mostre a estimativa como estimativa (PRD 8.5, 17).
  precisionKm  Float?
  /// Bairro resolvido pelo provider. Sustenta a busca por bairro quando a
  /// geocodificacao falha (PRD 8.2).
  neighborhood String?         @db.VarChar(80)

  lastValidatedAt DateTime? @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, position])
  @@index([applicationId])
}

/// Unidade escolar (PRD 11).
///
/// Carregada do artefato versionado gerado pelo pipeline (ADR-0034). Sao as 872
/// unidades que aparecem nas inscricoes de 2021 a 2025 — o melhor indicio
/// disponivel de quem oferta creche, ja que nao ha lista oficial de 2026.
model Unit {
  id   String  @id @default(uuid()) @db.Uuid
  /// `esc_codigo` normalizado. Chave natural vinda da origem (ADR-0018).
  code String  @unique @db.VarChar(7)
  name String  @db.VarChar(160)
  /// Tipo declarado na origem: Creche, EDI, Creche Parceira, CIEP...
  type String? @db.VarChar(40)

  neighborhood String? @db.VarChar(80)
  cep          String? @db.VarChar(8)
  cre          Int?    @db.SmallInt
  microarea    String? @db.VarChar(16)
  latitude     Float?
  longitude    Float?

  /// Grupamentos e turnos OBSERVADOS no historico, nao oferta declarada de 2026.
  /// PRD 8.5 exige que dado historico seja rotulado como historico.
  historicalAgeGroups String[]
  historicalShifts    String[]

  historicalApplications Int         @default(0)
  historicalChildren     Int         @default(0)
  historicalYears        Int         @default(0)
  /// Faixa relativa por quartil. PRD 8.5 proibe prometer chance de vaga.
  demandLevel            DemandLevel @default(BAIXA)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  preferences Preference[]

  @@index([neighborhood])
  @@index([cre])
  @@index([demandLevel])
}

/// Unidade escolhida e ordem (PRD 11, 8.6).
model Preference {
  id            String @id @default(uuid()) @db.Uuid
  applicationId String @db.Uuid
  unitId        String @db.Uuid
  /// 1 a 5, na ordem exata submetida pela familia (PRD 8.6).
  position      Int    @db.SmallInt

  /// Grupamento e turno pretendidos nesta escolha. Compoem a chave de unicidade
  /// de PRD 8.6: a mesma unidade pode voltar para outro grupamento ou turno.
  ageGroupCode String @db.VarChar(20)
  shift        String @db.VarChar(10)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  unit        Unit        @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@unique([applicationId, position])
  @@unique([applicationId, unitId, ageGroupCode, shift])
  @@index([applicationId])
  @@index([unitId])
}

/// Contato da familia, unificado por canal (PRD 11, 8.3, 8.4).
///
/// Telefone e perfil social convivem na mesma tabela porque as regras que
/// importam sao sobre o CONJUNTO — exatamente um principal, nunca ficar sem
/// telefone, rede social nunca como unico contato — e essas regras precisam
/// enxergar todos os canais de uma vez.
model ContactPoint {
  id            String         @id @default(uuid()) @db.Uuid
  applicationId String         @db.Uuid
  channel       ContactChannel

  /// Telefone em E.164. Nulo nos perfis sociais.
  e164 String? @db.VarChar(16)

  /// Plataforma e `@handle`. Nulos nos telefones.
  platform       SocialPlatform?
  handle         String?         @db.VarChar(30)
  /// PRD 8.4: o handle e mutavel, entao integracoes futuras devem preferir o
  /// identificador interno da plataforma. Ainda nao ha vinculacao real (B-06).
  platformUserId String?         @db.VarChar(64)

  /// Indice cego do valor normalizado (ADR-0027). Serve para detectar
  /// duplicidade sem comparar o valor, e para continuar servindo quando o valor
  /// passar a ser cifrado.
  fingerprint String @db.VarChar(64)

  /// Rotulo livre da familia. Texto escapado na exibicao.
  label     String?         @db.VarChar(60)
  relation  ContactRelation
  isPrimary Boolean         @default(false)
  priority  Int             @default(1) @db.SmallInt

  /// Consentimentos por meio (PRD 8.3). Nenhum e presumido.
  allowsCall           Boolean @default(false)
  allowsSms            Boolean @default(false)
  allowsWhatsapp       Boolean @default(false)
  /// PRD 8.4: autorizacao explicita para contato por rede social.
  allowsSocial         Boolean @default(false)
  /// PRD 8.3: telefone de terceiro exige confirmacao de autorizacao.
  thirdPartyAuthorized Boolean @default(false)

  status ContactStatus @default(INFORMED)

  /// OTP simulado (PRD 8.3). PRD 13.4 exige guardar token apenas como hash.
  otpHash      String?   @db.VarChar(64)
  otpExpiresAt DateTime? @db.Timestamptz(6)
  otpAttempts  Int       @default(0) @db.SmallInt

  consentedAt     DateTime? @db.Timestamptz(6)
  lastValidatedAt DateTime? @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([applicationId, channel])
  @@index([applicationId, fingerprint])
}

/// Transicao temporal de status (PRD 11, 16).
///
/// Tabela append-only, garantida por trigger na migration. PRD 10.4 registra que
/// a ausencia de timestamp de status na base historica impede calcular tempo real
/// de convocacao; aqui o historico e completo desde a origem.
model StatusEvent {
  id            String             @id @default(uuid()) @db.Uuid
  applicationId String             @db.Uuid
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  reason        String?
  correlationId String
  occurredAt    DateTime           @default(now()) @db.Timestamptz(6)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  @@index([applicationId, occurredAt])
}

/// Evento de auditoria append-only (PRD 8.16, 13.8).
///
/// PRD 13.8: "Logs de auditoria devem ser append-only" e "Acesso de administrador
/// nao deve eliminar rastreabilidade". A garantia e imposta por trigger no banco,
/// nao apenas por convencao de aplicacao.
///
/// PRD 8.16 proibe registrar telefone, `@handle`, token ou resposta sensivel.
/// O campo `metadata` passa pela mesma redacao aplicada aos logs.
model AuditEvent {
  id            String      @id @default(uuid()) @db.Uuid
  /// Identificador do ator. Na Fase 2 e sempre `system`/`anonymous`; a
  /// autenticacao simulada da Fase 10 passa a preencher o usuario real.
  actor         String
  actorRole     String
  action        String
  entity        String
  entityId      String
  /// `INTERFACE`, `API`, `WORKER` ou `IMPORTACAO` (PRD 8.16).
  origin        AuditOrigin
  correlationId String
  metadata      Json?
  occurredAt    DateTime    @default(now()) @db.Timestamptz(6)

  @@index([entity, entityId])
  @@index([occurredAt])
  @@index([correlationId])
}

/// Distingue dado sintetico de dado oficial (PRD 1.2).
enum DataStatus {
  DEMONSTRACAO
  OFICIAL
}

enum RuleKind {
  AGE_GROUP
  SCORING
  TIEBREAK
}

enum Sex {
  FEMININO
  MASCULINO
  NAO_INFORMADO
}

enum Shift {
  INTEGRAL
  PARCIAL
  AMBOS
}

enum ApplicationStatus {
  RASCUNHO
  SUBMETIDA
  CANCELADA
}

/// Faixa relativa de demanda historica, por quartil (PRD 8.5).
enum DemandLevel {
  BAIXA
  MEDIA
  ALTA
  MUITO_ALTA
}

enum ContactChannel {
  TELEFONE
  EMAIL
  SOCIAL
}

/// Plataformas de PRD 8.4. TikTok permanece adapter simulado (B-06).
enum SocialPlatform {
  INSTAGRAM
  FACEBOOK
  TIKTOK
  X
}

/// Maquina de status de PRD 8.4, usada tambem pelo OTP simulado do telefone.
enum ContactStatus {
  INFORMED
  PENDING_VERIFICATION
  VERIFIED
  INVALID
  REVOKED
}

/// Relacao com a crianca (PRD 8.3).
enum ContactRelation {
  RESPONSAVEL
  MAE
  PAI
  FAMILIAR
  VIZINHO
  OUTRO
}

/// Tipos de ponto de referencia de PRD 8.2.
enum AnchorKind {
  RESIDENCIA
  TRABALHO
  REDE_APOIO
  OUTRO
}

/// Resultado da geocodificacao. `FALHOU` nao e erro: PRD 8.2 exige que a familia
/// siga por bairro ou busca textual quando o CEP nao resolve.
enum GeocodingStatus {
  PENDENTE
  RESOLVIDO
  FALHOU
}

enum AuditOrigin {
  INTERFACE
  API
  WORKER
  IMPORTACAO
}
