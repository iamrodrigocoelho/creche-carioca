{
  "name": "match-perfeito",
  "version": "0.1.0",
  "private": true,
  "description": "Match Perfeito - Inteligencia na Inscricao de Creche (MVP). Ver PRD.md e docs/DESIGN.md.",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "e2e": "pnpm --filter @match/web exec playwright test",
    "db:migrate": "pnpm --filter @match/database run db:migrate",
    "db:deploy": "pnpm --filter @match/database run db:deploy",
    "db:status": "pnpm --filter @match/database run db:status",
    "db:seed": "pnpm --filter @match/database run db:seed",
    "db:studio": "pnpm --filter @match/database run db:studio",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0"
  }
}
