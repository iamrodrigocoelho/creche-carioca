{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  // O Turbo 2 opera em `envMode: strict`: a tarefa só recebe as variáveis
  // declaradas aqui. Sem `DATABASE_URL_TEST` o `globalSetup` do Vitest falha e o
  // Vitest mascara o erro como "No test files found" — sintoma que só aparece
  // onde não existe um `.env` local, isto é, no CI.
  "globalEnv": ["NODE_ENV", "DATABASE_URL", "DATABASE_URL_TEST"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
