# Creche Carioca - variaveis de ambiente de EXEMPLO.
# PRD 13.4: nunca versionar .env real, chaves, tokens ou dumps.
# Copie para .env e ajuste. Nenhum valor aqui e um segredo real.

# ---------- apps/api ----------
NODE_ENV=development
API_PORT=3333
# Allowlist de origens para CORS. Separe por virgula. Nunca use "*".
API_CORS_ORIGINS=http://localhost:3000
# Limite de payload aceito pela API (PRD 13.5).
API_BODY_LIMIT=256kb
# Rate limiting (PRD 13.5): janela em milissegundos e limite de requisicoes.
API_RATE_LIMIT_TTL_MS=60000
API_RATE_LIMIT=120
# Nivel de log JSON estruturado (PRD 16.1).
API_LOG_LEVEL=info

# ---------- apps/web ----------
# URL da API usada pelo navegador.
NEXT_PUBLIC_API_URL=http://localhost:3333

# ---------- Banco de dados (Fase 2) ----------
# PostgreSQL transacional. Use docker-compose.yml ou um PostgreSQL local.
# Com o docker-compose deste repositorio:
#   postgresql://match:match_local_dev@localhost:5432/match_perfeito?schema=public
DATABASE_URL=postgresql://USUARIO:SENHA@localhost:5432/match_perfeito?schema=public

# Banco usado pelos testes de integracao. Precisa ser um banco SEPARADO:
# a suite trunca as tabelas entre os testes.
DATABASE_URL_TEST=postgresql://USUARIO:SENHA@localhost:5432/match_perfeito_test?schema=public

# ---------- packages/data-pipeline (Fase 3) ----------
# Datasets historicos da SME/RJ. NAO sao versionados: baixe de
# https://github.com/CIT-SME-RJ/dadoscreche para `data/raw/`.
# Aponte para outro diretorio se quiser rodar sobre amostras menores.
# DATA_RAW_DIR=data/raw
# Destino das tabelas curadas em Parquet. Cada execucao cria um subdiretorio
# com a versao da importacao; o pipeline nunca sobrescreve uma versao existente.
# DATA_CURATED_DIR=data/curated

# ---------- Fase 11 em diante (ainda nao utilizados) ----------
# REDIS_URL=redis://localhost:6379

# ---------- Contatos (Fase 5) ----------
# Chave do indice cego de contatos (ADR-0028). Detecta telefone repetido sem
# comparar o valor. Gere a sua com: openssl rand -hex 32
# Trocar a chave invalida os indices ja gravados, e a deteccao de duplicidade
# para de funcionar para os contatos antigos ate serem reescritos.
CONTACT_FINGERPRINT_KEY=troque-por-uma-chave-aleatoria-de-64-hex
